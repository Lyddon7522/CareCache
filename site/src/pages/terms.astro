import LegalLayout from '../layouts/LegalLayout.astro';
import { siteConfig } from '../data/site';

const effectiveDate = 'Effective August 9, 2026';
---

<LegalLayout title="Terms of use | CareCache" description="Terms for using CareCache, including medical, reminder, backup, and availability disclaimers." heading="A useful tool, with honest limits." intro="CareCache helps organize information you enter. It does not make care decisions or replace your clinician, supplier, or device instructions." effectiveDate={effectiveDate}>
  <nav slot="contents"><a href="#agreement">Agreement</a><a href="#service">What it provides</a><a href="#medical">Medical disclaimer</a><a href="#content">Your information</a><a href="#reminders">Reminders</a><a href="#backups">Backups</a><a href="#availability">Availability</a><a href="#liability">Liability</a><a href="#changes">Changes</a></nav>
  <section id="agreement"><h2>Agreement</h2><p>These terms apply when you use the CareCache mobile application or website. By using CareCache, you agree to use it lawfully. If you do not agree, do not use CareCache.</p></section>
  <section id="service"><h2>What CareCache provides</h2><p>CareCache is a free, local-first tool for inventory, schedules, device reference information, reminders, and backups related to home medical supplies and devices. You are responsible for checking the accuracy of anything entered, scanned, recognized, or restored.</p></section>
  <section id="medical"><h2>Medical and safety disclaimer</h2><p>CareCache is not a medical device, diagnosis, treatment recommendation, prescription service, emergency service, or substitute for professional care. Saved prescription and setup values are reference notes only. Do not change therapy or device settings based on the app. Follow your clinician, pharmacist, supplier, and device instructions.</p><p>Replacement templates and schedules are organizational starting points, not medical instructions. If a health or equipment concern is urgent, contact an appropriate clinician, supplier, emergency service, or device manufacturer rather than relying on CareCache.</p></section>
  <section id="content"><h2>Your information and responsibilities</h2><p>You remain responsible for the records you add and for protecting your device and exported copies. Only store or share information you have the right to handle. Use fictional or carefully redacted examples in public support reports.</p></section>
  <section id="reminders"><h2>Reminder limitations</h2><p>Operating systems can delay or suppress notifications, and notifications can be removed. Reminders are an aid, not a guaranteed alert. Keep another safeguard for time-sensitive cleaning, replacement, supply, medication, or care needs.</p></section>
  <section id="backups"><h2>Backups and external services</h2><p>System share sheets, file providers, browsers, app stores, and other external services are operated by their providers. Their availability and handling are outside CareCache's control. Keep more than one copy of important records and periodically verify that a backup can be opened.</p></section>
  <section id="availability"><h2>Availability and changes</h2><p>CareCache can change as the project develops. Features and supported operating-system versions can be added, revised, or removed. No feature is guaranteed to remain available on every device.</p></section>
  <section id="liability"><h2>Warranty and liability</h2><p>To the extent permitted by law, CareCache is provided without warranties. {siteConfig.publisher} does not guarantee uninterrupted or error-free operation or suitability for a medical, legal, compliance, insurance, or record-retention purpose.</p><p>To the extent permitted by law, Vector42 is not liable for indirect, incidental, special, or consequential loss arising from use of CareCache, reliance on records or reminders, loss of local data, or use of external services. Rights that cannot legally be excluded remain in effect.</p></section>
  <section id="changes"><h2>Changes and contact</h2><p>These terms can be updated as CareCache changes. A revised effective date will appear above. Questions can be raised through the <a href="/support/">support page</a>.</p></section>
</LegalLayout>
