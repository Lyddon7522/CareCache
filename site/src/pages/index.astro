---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="main-content">
    <section class="hero">
      <div class="shell hero__grid">
        <div>
          <p class="eyebrow">Home medical supplies, organized</p>
          <h1>Know what you have.<br />Know what is next.</h1>
          <p class="hero__lead">
            CareCache keeps inventory, replacements, cleaning, device details, and reference
            settings together—without an account or a health-data cloud.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="#features">See what it keeps ready</a>
            <a class="button button--quiet" href="/privacy/">Read the privacy promise</a>
          </div>
          <div class="trust-line" aria-label="Product commitments">
            <span>Free</span><span>No tracking</span><span>Works offline</span>
          </div>
        </div>
        <div class="phone" aria-label="CareCache Overview screen preview">
          <div class="phone__screen">
            <div class="phone__top"><span>9:41</span><span>Settings</span></div>
            <h3>Overview</h3>
            <div class="attention-card">
              <strong>Needs attention</strong>
              <span>2 low-stock supplies and 1 overdue task</span>
            </div>
            <div class="mini-grid">
              <div class="mini-card"><b>12</b><span>supplies</span></div>
              <div class="mini-card"><b>3</b><span>scheduled</span></div>
            </div>
            <div class="task-preview">
              <div><i></i>Wash humidifier chamber</div>
              <div><i></i>Replace fine filter</div>
              <div><i></i>Check mask cushion stock</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--white" id="features">
      <div class="shell">
        <header class="section__intro">
          <p class="eyebrow">One clear overview</p>
          <h2>Know what you have and what comes next.</h2>
          <p>CPAP is the first polished workflow. The same structure works for many home medical supplies and devices.</p>
        </header>
        <div class="feature-grid">
          <article class="feature-card"><span class="feature-card__icon">▦</span><h3>Inventory at a glance</h3><p>Track quantities, reorder points, lots, expiration dates, locations, and linked devices.</p></article>
          <article class="feature-card"><span class="feature-card__icon">⌁</span><h3>Scan in or out</h3><p>Recognize a saved barcode instantly, or add details the first time a code appears.</p></article>
          <article class="feature-card"><span class="feature-card__icon">↻</span><h3>Maintenance schedules</h3><p>Keep cleaning, inspection, replacement, charging, and custom maintenance cadences.</p></article>
          <article class="feature-card"><span class="feature-card__icon">◫</span><h3>On-device label capture</h3><p>Use the camera to suggest names, models, lots, and dates, then review every field before saving.</p></article>
          <article class="feature-card"><span class="feature-card__icon">⌘</span><h3>Device reference</h3><p>Store model, serial, supplier, warranty, manual link, and prescription reference details together.</p></article>
          <article class="feature-card"><span class="feature-card__icon">⇧</span><h3>Portable backups</h3><p>Export a checksum-validated file to local storage or a file provider you already trust.</p></article>
        </div>
      </div>
    </section>

    <section class="section" id="privacy">
      <div class="shell privacy-block">
        <img src="/brand/carecache-glyph.svg" width="160" height="160" alt="" />
        <div>
          <p class="eyebrow">Privacy by architecture</p>
          <h2>Your records are not our data.</h2>
          <p>CareCache has no account, analytics, advertising, tracking SDK, or Vector42 health-data backend.</p>
          <ul class="privacy-list"><li>Useful offline from first launch</li><li>Camera and notifications are optional</li><li>Manual entry always remains available</li><li>You choose where exported backups go</li></ul>
          <p><a class="button" href="/privacy/">Read the full privacy policy</a></p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
