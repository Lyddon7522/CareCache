APP_IDENTIFIER = 'com.vector42.carecache'
REPOSITORY_ROOT = File.expand_path('..', __dir__)

ENV['FASTLANE_SKIP_UPDATE_CHECK'] ||= '1'
opt_out_usage

def required_environment_variable(name)
  value = ENV[name]&.strip
  UI.user_error!("#{name} must be configured before this lane can run.") if value.nil? || value.empty?
  value
end

def existing_file_from_environment(name, extension)
  file_path = File.expand_path(required_environment_variable(name), REPOSITORY_ROOT)
  UI.user_error!("#{name} does not point to a file: #{file_path}") unless File.file?(file_path)
  UI.user_error!("#{name} must point to a #{extension} file.") unless File.extname(file_path) == extension
  file_path
end

platform :android do
  desc 'Upload an existing signed AAB to Google Play Internal testing'
  lane :beta do
    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      aab: existing_file_from_environment('CARECACHE_ANDROID_AAB_PATH', '.aab'),
      json_key: existing_file_from_environment('GOOGLE_PLAY_CREDENTIALS_PATH', '.json'),
      track: 'internal',
      release_status: 'completed',
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

platform :ios do
  desc 'Upload an existing signed IPA to TestFlight internal testing'
  lane :beta do
    ipa_path = existing_file_from_environment('CARECACHE_IOS_IPA_PATH', '.ipa')
    group = ENV['TESTFLIGHT_INTERNAL_GROUP']&.strip
    api_key = app_store_connect_api_key(
      key_id: required_environment_variable('APP_STORE_CONNECT_KEY_ID'),
      issuer_id: required_environment_variable('APP_STORE_CONNECT_ISSUER_ID'),
      key_content: required_environment_variable('APP_STORE_CONNECT_PRIVATE_KEY_BASE64'),
      is_key_content_base64: true,
    )

    options = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      distribute_external: false,
      notify_external_testers: false,
      uses_non_exempt_encryption: false,
    }
    if group.nil? || group.empty?
      options[:skip_submission] = true
      options[:skip_waiting_for_build_processing] = true
    else
      options[:groups] = [group]
      options[:submit_beta_review] = false
      options[:skip_waiting_for_build_processing] = false
      options[:wait_processing_timeout_duration] = 1_800
    end
    upload_to_testflight(**options)
  end
end
